{
  "name": "triptych",
  "version": "2.3.0",
  "description": "A sleek, Spotify-style desktop client for your own Jellyfin music server",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-media-session": "^8.0.29",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@fontsource/poppins": "^5.3.0",
    "@xhayper/discord-rpc": "^1.3.4"
  },
  "build": {
    "appId": "com.triptych.app",
    "productName": "Triptych",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "update-checker.js",
      "src/**/*",
      "node_modules/**/*",
      "downloader/**/*",
      "!downloader/cookies.txt",
      "!downloader/__pycache__/**",
      "native/smtc/smtc.node"
    ],
    "asarUnpack": [
      "downloader/**/*",
      "native/smtc/smtc.node"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "logo.png",
      "category": "public.app-category.music",
      "identity": "-",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "snap"],
      "icon": "logo.png",
      "category": "Audio"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "license": "build/license.txt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "shortcutName": "Triptych",
      "uninstallDisplayName": "Triptych"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "sharp@0.32.6": true,
    "electron-winstaller": false
  }
}
